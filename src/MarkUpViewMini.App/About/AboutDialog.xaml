<Window x:Class="MarkUpViewMini.App.About.AboutDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MarkUpViewMini.App.Localization"
        x:ClassModifier="internal"
        Title="{Binding [about.title], Source={x:Static loc:AppLocalization.Source}}"
        Width="620"
        Height="620"
        MinWidth="480"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        Loaded="AboutDialog_Loaded"
        PreviewKeyDown="AboutDialog_PreviewKeyDown">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <TextBlock x:Name="ErrorText"
                   Padding="8"
                   Background="#FFFFE8E6"
                   Foreground="#FFB42318"
                   TextWrapping="Wrap"
                   Visibility="Collapsed"
                   AutomationProperties.LiveSetting="Assertive" />

        <FlowDocumentScrollViewer x:Name="BodyText"
                                  Grid.Row="1"
                                  Margin="0,10,0,0"
                                  IsSelectionEnabled="True"
                                  IsToolBarVisible="False"
                                  VerticalScrollBarVisibility="Auto"
                                  AutomationProperties.Name="{Binding [about.body], Source={x:Static loc:AppLocalization.Source}}">
            <FlowDocument x:Name="BodyDocument"
                          PagePadding="8" />
        </FlowDocumentScrollViewer>

        <Button x:Name="CloseButton"
                Grid.Row="2"
                Margin="0,10,0,0"
                Padding="16,5"
                HorizontalAlignment="Right"
                IsDefault="True"
                Content="{Binding [about.close], Source={x:Static loc:AppLocalization.Source}}"
                Click="Close_Click"
                AutomationProperties.Name="{Binding [about.close], Source={x:Static loc:AppLocalization.Source}}" />
    </Grid>
</Window>
