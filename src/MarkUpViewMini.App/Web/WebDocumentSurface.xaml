<UserControl x:Class="MarkUpViewMini.App.Web.WebDocumentSurface"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:loc="clr-namespace:MarkUpViewMini.App.Localization"
             xmlns:wv2="clr-namespace:Microsoft.Web.WebView2.Wpf;assembly=Microsoft.Web.WebView2.Wpf">
    <Grid Background="White">
        <Grid x:Name="BrowserHost" />
        <Border x:Name="SurfaceError"
                Background="#FFFDF3D7"
                BorderBrush="#FFE3B341"
                BorderThickness="0,0,0,1"
                Padding="12"
                VerticalAlignment="Top"
                AutomationProperties.Name="{Binding [surface.error], Source={x:Static loc:AppLocalization.Source}}"
                AutomationProperties.LiveSetting="Assertive"
                Visibility="Collapsed">
            <DockPanel LastChildFill="True">
                <StackPanel DockPanel.Dock="Right"
                            Margin="12,0,0,0"
                            Orientation="Horizontal">
                    <Button Padding="12,4"
                            Click="CopyDiagnostics_Click"
                            Content="{Binding [surface.copyDiagnostics], Source={x:Static loc:AppLocalization.Source}}"
                            AutomationProperties.Name="{Binding [surface.copyDiagnosticsName], Source={x:Static loc:AppLocalization.Source}}" />
                    <Button Margin="6,0,0,0"
                            Padding="12,4"
                            Click="RetryInitialization_Click"
                            Content="{Binding [surface.retry], Source={x:Static loc:AppLocalization.Source}}"
                            AutomationProperties.Name="{Binding [surface.retryName], Source={x:Static loc:AppLocalization.Source}}" />
                </StackPanel>
                <TextBlock VerticalAlignment="Center"
                           Text="{Binding [surface.startFailed], Source={x:Static loc:AppLocalization.Source}}" />
            </DockPanel>
        </Border>
    </Grid>
</UserControl>
