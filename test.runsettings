<?xml version="1.0" encoding="utf-8"?>
<!--
  AppLocalization resolves the app's UI language from the OS's current UI
  culture the first time it is touched in a process (see
  src/MarkUpViewMini.App/Localization/AppLocalization.cs). Several tests
  assert exact Korean UI strings, matching the maintainers' machines. Pinning
  the test host culture here keeps that behavior reproducible on any runner,
  including CI images whose default OS locale is English.
-->
<RunSettings>
  <RunConfiguration>
    <Culture>ko-KR</Culture>
    <UICulture>ko-KR</UICulture>
  </RunConfiguration>
</RunSettings>
